# Sarathi Journey Environment Configuration

# Optional: OpenAI API Key for live AI Assistant responses
# If left empty, the project uses the built-in statutory CMVR knowledge engine offline.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI model (e.g. gpt-4o, gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
